# Token de ton bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Clé API Gemini gratuite (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modèle Gemini à utiliser (gemini-2.5-flash recommandé, gratuit et rapide)
GEMINI_MODEL=gemini-2.5-flash

# Clé API Groq gratuite (https://console.groq.com) — nécessaire pour la
# transcription vocale (Whisper). Pas de carte bancaire requise.
GROQ_API_KEY=

# Voix utilisée pour la synthèse vocale (StreamElements). "Mathieu" = voix
# française. Autres options : Brian, Amy, Justin, Emma...
TTS_VOICE=fr-FR-HenriNeural