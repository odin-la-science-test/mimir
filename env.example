# Token de ton bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_discord_token_here

# Clé(s) API Gemini gratuite(s) (https://aistudio.google.com/apikey)
# Pour CUMULER plusieurs quotas gratuits, sépare les clés par des virgules :
# GEMINI_API_KEY=key1,key2,key3
# Le bot basculera automatiquement vers la clé suivante quand une atteint sa limite.
# Chaque clé gratuite a environ 20-50 requêtes/jour selon le projet Google.
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini à utiliser (gemini-2.5-flash recommandé, gratuit et rapide)
GEMINI_MODEL=gemini-2.5-flash

# Clé API Groq gratuite pour la transcription vocale (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Voix française pour la synthèse vocale (Microsoft Edge TTS, gratuit)
# Autres voix FR : fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural, fr-CA-JeanNeural
TTS_VOICE=fr-FR-HenriNeural
GROQ_API_KEY=your_groq_api_key_here

# Voix française pour la synthèse vocale (Microsoft Edge TTS, gratuit)
# Autres voix FR : fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural, fr-CA-JeanNeural
TTS_VOICE=fr-FR-HenriNeural
