# Token de ton bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_discord_token_here

# ============================================================
# CONFIGURATION DES PROVIDERS IA (Rotation automatique)
# ============================================================
# Le bot utilise une rotation intelligente entre providers :
# Gemini (3 clés) → Groq → Mistral (2 clés) → retour à Gemini
# Configure au moins un provider, idéalement plusieurs pour maximiser le quota.

# Clé(s) API Gemini gratuite(s) (https://aistudio.google.com/apikey)
# Pour CUMULER plusieurs quotas, sépare les clés par des virgules
# Quota: ~20-50 requêtes/jour par clé
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini à utiliser
GEMINI_MODEL=gemini-2.5-flash

# Clé API Groq gratuite (https://console.groq.com)
# Ultra rapide (500 tokens/sec) et quota généreux (14 400 req/jour)
# Utilisé aussi pour la transcription vocale (Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Clé(s) API Mistral gratuite(s) (https://console.mistral.ai)
# Excellent en français, ~1M tokens gratuits/mois
# Pour CUMULER plusieurs quotas, sépare les clés par des virgules
MISTRAL_API_KEY=your_mistral_api_key_here

# Voix française pour la synthèse vocale (Microsoft Edge TTS, gratuit)
# Autres voix FR : fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural, fr-CA-JeanNeural
TTS_VOICE=fr-FR-HenriNeural

GROQ_API_KEY=your_groq_api_key_here

# Voix française pour la synthèse vocale (Microsoft Edge TTS, gratuit)
# Autres voix FR : fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural, fr-CA-JeanNeural
TTS_VOICE=fr-FR-HenriNeural
