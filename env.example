# Token de ton bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_discord_token_here

# ============================================================
# CONFIGURATION DES PROVIDERS IA (Rotation automatique)
# ============================================================
# Le bot utilise une rotation intelligente entre providers :
# Gemini (3 clés) → Groq → Mistral (2 clés) → retour à Gemini
# Configure au moins un provider, idéalement plusieurs pour maximiser le quota.

# Clé(s) API Gemini gratuite(s) (https://aistudio.google.com/apikey)
# Pour CUMULER plusieurs quotas, sépare les clés par des virgules
# Quota: ~20-50 requêtes/jour par clé
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini à utiliser (gemini-2.5-flash sera arrêté le 16/10/2026,
# préfère gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Clé API Groq gratuite (https://console.groq.com)
# Ultra rapide (500 tokens/sec) et quota généreux (14 400 req/jour)
# Utilisé aussi pour la transcription vocale (Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Clé(s) API Mistral gratuite(s) (https://console.mistral.ai)
# Excellent en français, ~1M tokens gratuits/mois
# Pour CUMULER plusieurs quotas, sépare les clés par des virgules
MISTRAL_API_KEY=your_mistral_api_key_here

# Voix française pour la synthèse vocale (Microsoft Edge TTS, gratuit)
# Voix masculines professionnelles :
#   - fr-FR-AlainNeural (professionnel et posé, recommandé)
#   - fr-FR-HenriNeural (masculine standard)
#   - fr-FR-RemyMultilingualNeural (multilingue)
# Voix féminines :
#   - fr-FR-EloiseNeural, fr-FR-DeniseNeural
TTS_VOICE=fr-FR-AlainNeural

# ============================================================
# TTS DE SECOURS : microsoft Edge TTS ci-dessus est gratuit mais non
# officiel — Microsoft bloque parfois les connexions depuis les IP
# mutualisées de certains hébergeurs cloud (confirmé sur Fly.io, voir
# docs/adr/0011 et docs/adr/0012). Si le bot répond en texte avec
# "Stream closed before the synthesis completed", configure UN des deux
# providers ci-dessous. Priorité si les deux sont configurés : ElevenLabs
# d'abord, Google Cloud ensuite.
# ============================================================

# --- Option recommandée : ElevenLabs (~10k caractères/mois gratuits) ---
# 1. https://elevenlabs.io → créer un compte
#    (vérifie toi-même si une carte bancaire est demandée à l'inscription
#    avant de continuer — non confirmé de notre côté au moment d'écrire
#    ceci, voir docs/adr/0012-choix-final-tts-elevenlabs.md)
# 2. Dashboard > Profile > API Keys → créer une clé
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ID de voix (dashboard ElevenLabs > Voices, onglet "Voice Library" pour
# en choisir une autre). Valeur par défaut = un ID d'exemple documenté
# officiellement par ElevenLabs, à vérifier qu'il est bien disponible
# sur ton compte.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Option alternative : Google Cloud (carte bancaire requise, tier
# gratuit permanent bien plus large : 4M caractères/mois) ---
# 1. https://console.cloud.google.com → nouveau projet
# 2. Activer "Cloud Text-to-Speech API"
# 3. Identifiants → Créer une clé API
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Catalogue de voix DIFFÉRENT de TTS_VOICE (Standard/Wavenet/Neural2, pas
# "...Neural" à la Microsoft). Liste complète :
# https://cloud.google.com/text-to-speech/docs/list-voices-and-types
# GOOGLE_TTS_VOICE=fr-FR-Standard-A
