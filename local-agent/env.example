# Copie ce fichier vers local-agent/.env et remplis les valeurs.
# local-agent/.env est ignoré par git (contient un secret) — ne le commite jamais.

# URL WebSocket du bot en production (wss:// obligatoire, pas ws://)
BOT_WS_URL=wss://mimir-bot.fly.dev/agent-bridge

# Même valeur que le secret LOCAL_AGENT_TOKEN configuré sur Fly.io
# (voir README.md à la racine du projet, section "Codage à distance").
LOCAL_AGENT_TOKEN=colle_ici_le_meme_token_que_sur_fly_io
